#!/usr/bin/env bash
# Unattended Ralph: one task per run, on the first scheduled agent that still has usage.
# Being the only launcher, it never meets Ralph's lock. See README.md.
set -euo pipefail
here="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
root="$(git rev-parse --show-toplevel)"
cd -- "$root"
export PATH="$HOME/.bun/bin:$PATH"

# --init: one-time setup of a new checkout. Never overwrites; safe to run again.
if [[ "${1-}" == --init ]]; then
  (( $# == 1 )) || { echo 'Usage: ralph-afk --init' >&2; exit 2; }
  [[ -d .beads ]] || bd init
  if ! grep -qx '## Ralph runs' AGENTS.md 2>/dev/null; then
    [[ ! -s AGENTS.md ]] || echo >> AGENTS.md
    cat >> AGENTS.md <<'EOF'
## Ralph runs

The owner authorizes Ralph runs (`ralph`, `ralph-afk`, `ralph-afk --pr`) to
implement ready Beads tasks, verify them, close finished tasks and commit
without asking for approval. Choose and record sensible defaults for routine
decisions. In PR mode, workers push their task branch and open a pull request,
reviewers and the merger push to pull request branches, and ralph-afk
squash-merges them.
EOF
    echo 'Added the Ralph runs authorization to AGENTS.md.'
  fi
  cat <<EOF
Left for you:
1. In Claude Code, run /setup-matt-pocock-skills with Beads as the tracker.
2. Name the project's test and format commands in AGENTS.md.
3. --pr only: set up CI on GitHub.
4. Smoke test: ralph --agent codex --iterations 1
To change a --pr prompt for this project, copy $(readlink -f -- "$here/../prompts")/pr-<stage>.md to .ralph-tui/ and edit it.
EOF
  exit 0
fi

# Two supervisors would take over each other's Ralph forever.
mkdir -p .ralph-tui
exec 9>.ralph-tui/afk.lock
flock -n 9 || { echo 'ralph-afk is already running in this checkout.' >&2; exit 1; }
# Each owner keeps their own agents table out of Git; RALPH_AGENTS points elsewhere (the tests use the example).
# A checkout's own .ralph-tui/agents beats the shared one.
[[ -f .ralph-tui/agents ]] && agents=.ralph-tui/agents || agents="$here/../agents"
agents="${RALPH_AGENTS:-$agents}"
[[ -f "$agents" ]] || { echo "Missing $agents: cp $(readlink -f -- "$here/../agents.example") $agents, then edit it." >&2; exit 1; }
# Every line is worker, reviewer or merger, for claude or codex: the agents with a built-in probe; or worker|human,
# reviewer|human, reviewer|none or a setting. This also catches the retired ralph stage and the old probe column.
# bin/ralph-agents.mjs does the check, the same one ralph-pr.mjs and the dashboard use.
node "$here/ralph-agents.mjs" "$agents" || exit 1
usage='Usage: ralph-afk [epic...] | ralph-afk --pr | ralph-afk --init'
# The agents file is the only list of agents: comment a line out to stop using that agent.
mapfile -t known < <(awk -F'|' '$1 == "worker" { print $2 }' "$agents")
pr=false
given=()
while (( $# )); do
  case "$1" in
    --pr) pr=true; shift ;;
    -*) echo "$usage" >&2; exit 2 ;;
    *) given+=("$1"); shift ;;
  esac
done
"$pr" && (( ${#given[@]} )) && { echo "$usage" >&2; exit 2; }
# Epics are worked in the order given; the default is every ready epic, oldest first.
# Blocking dependencies between epics set the release order. Re-read before every task.
# The full suites run once, when every epic is out of ready work, in a gate epic made here.
# Due only when a task closed after the last gate closed and no gate is still open,
# so a finished or blocked gate never makes another.
make_gate() {
  local gate
  bd list --all --json --limit 0 | jq -e 'def gate: (.labels // []) | index("gate:backlog");
    map(select(gate)) as $g | ($g | all(.status == "closed")) and
    ([.[] | select((gate | not) and .issue_type != "epic" and .status == "closed") | .closed_at] | max) > ([$g[].closed_at] | max // "")' > /dev/null || return 1
  # bd cannot change a database's issue_prefix, so honour config.yaml's issue-prefix with --force and an explicit ID.
  local prefix suffix id=()
  prefix="$(sed -n 's/^issue-prefix: *"\{0,1\}\([^"]*\)"\{0,1\} *$/\1/p' .beads/config.yaml 2>/dev/null)"
  if [[ -n "$prefix" ]]; then
    while suffix="$(tr -dc a-z0-9 < /dev/urandom | head -c 3)"; bd show "$prefix-$suffix" > /dev/null 2>&1; do :; done
    id=(--force --id "$prefix-$suffix")
  fi
  gate="$(bd create "${id[@]}" --type epic --title 'Full-suite gate' --labels gate:backlog --silent)" &&
    bd create --force --type task --parent "$gate" --title 'Run the full test suites' --labels gate:backlog --silent \
      --description "Review and fix; do not file tickets for what you can fix. Run every full test suite the project's testing guide names and fix every failure, then rerun until all pass. Review the commits since the last gate (git log --grep 'Run the full test suites') for defects the suites miss and fix them. If one run cannot finish, record a checkpoint in the notes and leave this open. Mark it blocked only for a concrete external blocker." \
      --acceptance $'- [ ] Every full suite passes\n- [ ] Defects found in the commits since the last gate are fixed' > /dev/null &&
    log "Out of ready work: made gate epic $gate for the full suites."
}
load_epics() {
  epics=("${given[@]}")
  (( ${#epics[@]} )) || mapfile -t epics < <(bd ready --type epic --sort oldest --json --limit 0 | jq -r '.[].id')
}
# A setting's first line in the agents file, else its default (the same as in bin/ralph-agents.mjs).
setting() { awk -F'|' -v key="$1" '$1 == key { print $2; found = 1; exit } END { if (!found) print def }' def="$2" "$agents"; }
# schedule: space-separated FROM-TO=agents windows in local hours; agents are tried in order.
# An hour outside every window runs nothing.
schedule="$(setting schedule 00-24=claude,codex)"
wait_s="$(setting wait 600)"
# --pr: workers|N workers open one PR per task, reviewers|N reviewers approve them and ralph-pr.mjs merges them. The lock stays held.
if "$pr"; then exec node "$here/ralph-pr.mjs"; fi
log() { echo "[ralph-afk $(date '+%F %T')] $*"; }

agents_now() {
  local hour=$((10#$(date +%H))) window hours list agent
  for window in $schedule; do
    hours="${window%%=*}"
    if (( hour >= 10#${hours%-*} && hour < 10#${hours#*-} )); then
      list="${window#*=}"
      for agent in ${list//,/ }; do
        if [[ " ${known[*]} " == *" $agent "* ]]; then printf '%s ' "$agent"; fi
      done
      return
    fi
  done
}

# Ask the real CLI with a cheap model (ralph-probe.mjs). A limited agent says when it resets;
# resets[agent] keeps that (epoch seconds). One that does not say gets an empty entry,
# so it is checked again after the wait setting.
declare -A resets=()
usable() {
  local at
  at="$(node "$here/ralph-probe.mjs" "$1")" && return 0
  resets[$1]="$at"
  return 1
}

count() { bd "$@" --parent "$epic" --json --limit 0 | jq length; }
# Ralph only sees the epic's children, so a parentless blocker (a bug filed mid-task) would
# hold the epic forever. Move it under the epic so Ralph can work it.
# shortcut: a blocker that belongs to another epic is left alone; adopt those too if it ever deadlocks.
adopt_blockers() {
  local id
  for id in $(bd list --parent "$epic" --status open,in_progress,blocked --json --limit 0 |
      jq -r --arg epic "$epic" '[.[].dependencies[]? | select(.type == "blocks") | .depends_on_id | select(startswith($epic + ".") | not)] | unique[]'); do
    bd show "$id" --json | jq -e '(.[0] // .) | .parent == null and .status != "closed" and .issue_type != "epic"' > /dev/null || continue
    if bd update "$id" --parent "$epic" > /dev/null; then log "Moved $id under $epic: it blocks work there."; fi
  done
}
closed() { bd list --parent "$epic" --status closed --json --limit 0; }
# Ralph 0.12.0 headless never reports a failed auto-commit, so a closed task's edits can stay
# uncommitted. Commit them here in Ralph's message format; a hook that rejects it is skipped.
commit_leftovers() {
  local msg
  [[ "$(git rev-parse -q --verify HEAD || :)" == "$head" && -n "$(git status --porcelain)" ]] || return 0
  msg="$(closed | jq -r --argjson before "$closed_before" '[.[] | select(.id | IN($before[]) | not)][0] // empty | "\(.issue_type): \(.id) \(.title)"')"
  [[ -n "$msg" ]] || return 0
  if git add -A && { git commit -q -m "$msg" || git commit -q --no-verify -m "$msg"; }; then
    log "Ralph left the task uncommitted. Committed: $msg"
  else
    log "Could not commit the finished task ($msg). Its edits are still uncommitted."
  fi
}

run_pid=''
cleanup() {
  if [[ -n "$run_pid" ]] && kill -0 "$run_pid" 2>/dev/null; then
    node "$here/ralph-takeover.mjs" "$run_pid" 9>&-
  fi
}
trap cleanup EXIT
trap 'exit 143' TERM
# First Ctrl+C: let the current task finish, then exit. Second Ctrl+C: stop now.
stop=false
on_int() {
  if "$stop"; then exit 130; fi
  stop=true
  log "Stopping after the current task. Press Ctrl+C again to stop now."
}
trap on_int INT

last=''
while :; do
  if "$stop"; then
    log "Stop requested. Stopping."
    exit 0
  fi
  # A finished epic closes here, which unblocks the epics that depend on it.
  closed="$(bd epic close-eligible --json | jq -r '.closed | join(" ")')" || closed=''
  [[ -z "$closed" ]] || log "Closed finished epics: $closed"
  load_epics
  # First epic that still has ready or unfinished work: a later phase starts when the earlier ones are out of work.
  epic=''
  for e in "${epics[@]}"; do
    epic="$e"
    adopt_blockers
    # An in-review task waits on its --pr PR: it is not unfinished work.
    (( $(count ready) + $(bd list --status in_progress --parent "$epic" --json --limit 0 | jq 'map(select(.labels // [] | index("in-review") | not)) | length') == 0 )) || break
    epic=''
  done
  if [[ -z "$epic" ]]; then
    # Only without given epics: a gate outside the given list would never run.
    if (( ! ${#given[@]} )) && make_gate; then continue; fi
    log "No ready work under ${epics[*]:-any epic}. Stopping."
    exit 0
  fi
  agent=''
  candidates=" $(agents_now) "
  # No favourite: stay on the agent that ran last and switch only when it stops answering.
  if [[ -n "$last" && "$candidates" == *" $last "* ]]; then candidates="$last ${candidates/ $last / }"; fi
  for candidate in $candidates; do
    if usable "$candidate"; then agent="$candidate"; break; fi
    log "$candidate is not usable now (usage limit, auth or network)."
  done
  if [[ -z "$agent" ]]; then
    # Wake at the first reset; an agent with no reset time keeps the fixed wait. Then probe every agent again.
    read -r now min sec < <(date '+%s %M %S')
    wake=''
    for candidate in $candidates; do
      at="${resets[$candidate]:-$((now + wait_s))}"
      [[ -n "$wake" ]] && (( at >= wake )) || wake=$at
    done
    wake="${wake:-$((now + wait_s))}" # outside every window
    # Several windows: wake by the next hour too, when another window may bring a usable agent.
    next_hour=$((now - 10#$min * 60 - 10#$sec + 3600))
    (( $(wc -w <<< "$schedule") < 2 || wake <= next_hour )) || wake=$next_hour
    log "No agent available. Checking again in $((wake - now))s."
    sleep "$((wake - now))" || :
    continue
  fi
  log "Starting one task of $epic on $agent."
  last="$agent"
  started=$SECONDS
  finished=$(count list --status closed,blocked)
  head="$(git rev-parse -q --verify HEAD || :)"
  closed_before="$(closed | jq -c 'map(.id)')"
  # 9>&-: a Ralph that outlives this script must not keep the supervisor lock.
  # setsid: Ctrl+C in this terminal reaches only the supervisor, never the running task.
  # A limit hit mid-task fails the iteration and ends Ralph; the next cycle probes again.
  setsid "$here/ralph" "$epic" --takeover --iterations 1 --agent "$agent" < /dev/null 9>&- &
  run_pid=$!
  while :; do
    wait "$run_pid" && status=0 || status=$?
    # A trapped Ctrl+C also ends wait: keep waiting while the task runs.
    kill -0 "$run_pid" 2>/dev/null || break
  done
  run_pid=''
  (( status == 0 )) || log "Ralph exited with status $status."
  commit_leftovers
  # A short run that closed or blocked nothing did no work (limit hit at once, startup failure, crash): do not spin.
  if (( SECONDS - started < 120 && $(count list --status closed,blocked) <= finished )); then
    log "Run ended within 2 minutes without finishing a task. Checking again in ${wait_s}s."
    sleep "$wait_s" || :
  fi
done
