#!/usr/bin/env bash
# ralph-pr.mjs puts this first on every agent's PATH. Anyone can open a PR or issue, or comment, on a public repo, so
# agents never read that text: this refuses the gh calls that return it, and the supervisor hands a fixing worker the
# owner's own review comments. shortcut: a denylist of known gh reads, so a gh command or API path not on it, a gh
# alias, and curl with the gh token still reach that text; switch to an allowlist when agents need more gh than this.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)"
deny() { echo "ralph-afk blocked \`gh $*\`: it returns text other GitHub accounts can write. Your prompt has what you need." >&2; exit 64; }

fields='' prev='' author='' comments='' path='' list='' view=''
for arg in "$@"; do
  [[ $prev == --json ]] && fields=$arg
  [[ $arg == --json=* ]] && fields=${arg#--json=}
  [[ $prev == --author || $prev == -A ]] && author=$arg
  [[ $arg == --author=* ]] && author=${arg#--author=}
  [[ $arg == -A?* ]] && author=${arg#-A}
  [[ $arg == list || $arg == ls ]] && list=1
  [[ $arg == view ]] && view=1
  [[ $arg == --comments || $arg == -c ]] && comments=1
  [[ $arg =~ graphql|(^|/)(comments|reviews|issues|events|timeline|notifications|runs)(/|\?|$)|/pulls(\?|$) ]] && path=1
  prev=$arg
done
[[ ,$fields, =~ ,(comments|reviews|latestReviews), ]] && deny "$@"
case "$1" in
  issue | search | status) deny "$@" ;;
  run) [[ -z $list ]] || deny "$@" ;;
  workflow) [[ -z $view ]] || deny "$@" ;; # its recent runs carry strangers' PR titles
  api) [[ -z $path ]] || deny "$@" ;;
  pr)
    [[ -n $list && $author != @me ]] && deny "$@"
    [[ ($2 == view || $2 == status) && -n $comments ]] && deny "$@"
    ;;
esac
[[ "$(command -v gh)" != "$here/gh" ]] || { echo 'ralph-afk: no gh on PATH besides the guard.' >&2; exit 127; }
exec gh "$@"
